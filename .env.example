# Copy to .env (run_cybertwin.bat does this automatically). Never commit .env.
# Optional: enables Claude-backed investigation answers (backend only). Leave empty for the deterministic fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: PostgreSQL instead of SQLite, e.g. postgresql+psycopg://user:pass@host:5432/cybertwin (install psycopg separately)
DATABASE_URL=
# Optional: where the SQLite file and model are stored (use a mounted volume in Docker)
CYBERTWIN_DATA_DIR=
PORT=8000
